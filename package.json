{
  "name": "@velocity-bpa/n8n-nodes-aftership",
  "version": "1.0.0",
  "description": "n8n community node for AfterShip - shipment tracking and delivery management platform",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://velocity-bpa.com",
  "author": {
    "name": "Velocity BPA",
    "email": "support@velocity-bpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/velocity-bpa/n8n-nodes-aftership.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AfterShipApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AfterShip/AfterShip.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "n8n-workflow": "1.57.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "aftership",
    "tracking",
    "shipping",
    "logistics",
    "courier",
    "delivery",
    "webhook",
    "notification"
  ]
}